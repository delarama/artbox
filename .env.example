# Database (required for production mode)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/artbox?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3000"

# Comma-separated admin emails (can advance orders in production)
ADMIN_EMAILS="you@example.com"

# OAuth (optional — enable Google / Apple sign-in)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_ID=""
APPLE_SECRET=""

# Stripe (optional — without these, checkout runs in demo mode even with a database)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email via Resend (optional — logs to console in dev without this)
RESEND_API_KEY=""
EMAIL_FROM="ArtBox <hello@artbox.ca>"

# Object storage — Cloudflare R2 / AWS S3 (optional — uses local uploads/ folder if unset)
S3_BUCKET=""
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
S3_FORCE_PATH_STYLE="true"
